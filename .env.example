# Example environment configuration for LWrite.
#
# LWrite is a static, client-only Vite app. Vite only exposes variables that
# start with `VITE_`, and ALL of them are inlined into the public client bundle
# at BUILD time. There is no server that can keep values private, so only set
# values you are willing to publish.
#
# Production deployments (e.g. Cloudflare Pages build settings) MUST configure
# the LEGAL_* values below so the /privacy and /terms pages show a real
# responsible-party contact instead of a development placeholder.
#
# Copy this file to `.env.local` for local development. Do NOT commit real
# private contact details to this public repository — configure them only in
# your deployment environment.

# Public project identity
VITE_SITE_NAME="Example Hobby Project"
VITE_SITE_URL="https://example.com"

# Responsible party / data-controller contact (publicly displayed).
# A single contact email is enough — set VITE_LEGAL_CONTACT_EMAIL and the
# legal pages will show a real contact. Name and URL are optional extras.
# Leave all empty in local dev to show the neutral placeholder; configure at
# least the email in production.
VITE_LEGAL_CONTROLLER_NAME=""
VITE_LEGAL_CONTACT_EMAIL=""
VITE_LEGAL_CONTACT_URL=""

# Legal metadata
VITE_LEGAL_JURISDICTION="Germany / EU"
VITE_LEGAL_LAST_UPDATED="2026-06-15"
