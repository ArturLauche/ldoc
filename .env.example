# Optional public build configuration. All VITE_* values are public.
# Copy to .env.local for development or use Cloudflare Pages build settings.

VITE_SITE_NAME="LWrite"
# Leave blank to use the production fallback (https://write.leunos.com) or
# Cloudflare preview URL. Runtime metadata always detects the current origin.
VITE_SITE_URL=""

# The operator must supply a real PUBLIC email or contact-page URL.
# No contact address is assumed or generated by the application.
VITE_LEGAL_CONTROLLER_NAME=""
VITE_LEGAL_CONTACT_EMAIL=""
VITE_LEGAL_CONTACT_URL=""

VITE_LEGAL_JURISDICTION="Germany / EU"
VITE_LEGAL_LAST_UPDATED="2026-06-16"
